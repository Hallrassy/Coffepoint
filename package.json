{
  "name": "coffepoint",
  "version": "1.0.0",
  "description": "Сервис бронирования кофеен на Vanilla JS и Firebase",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/validation.test.js",
    "test:rules": "firebase emulators:exec --project demo-coffepoint --only firestore \"node --test tests/firestore.test.js\"",
    "test:browser": "playwright test",
    "test:e2e": "firebase emulators:exec --project demo-coffepoint --only auth,firestore \"npm run test:browser\"",
    "emulators": "firebase emulators:start --project demo-coffepoint --only auth,firestore",
    "dev:emulators": "VITE_USE_FIREBASE_EMULATORS=true vite --host 0.0.0.0",
    "deploy:rules": "firebase deploy --only firestore --project coffepoint-for-college",
    "seed:emulators": "node scripts/seed-emulators.js"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "firebase-tools": "^15.30.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  }
}

# Firebase Console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Для локальных эмуляторов: true; для реального проекта: false.
VITE_USE_FIREBASE_EMULATORS=false
# Только для npm run dev: вымышленные номера, добавленные в Firebase Console.
# Production-сборка игнорирует этот флаг.
VITE_FIREBASE_TEST_PHONE_AUTH=false
